# Copy to .env with `pnpm setup` (fills the __GENERATE__ values with random secrets).
# Never commit .env. Production values live in the hosting provider's secret manager.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# Origins allowed to send state-changing requests (comma-separated).
# `pnpm setup` fills in your Codespace URL automatically.
APP_ORIGIN=http://localhost:3000
# true when running behind a proxy/CDN that sets X-Forwarded-For (Codespaces, Cloudflare)
TRUST_PROXY=true
SESSION_COOKIE_SECURE=true

# --- Web ---
# Where the Next.js server forwards /api/* requests.
API_INTERNAL_URL=http://localhost:4000

# --- Database / Redis (the devcontainer's services) ---
DATABASE_URL=postgres://souqna:souqna@postgres:5432/souqna
TEST_DATABASE_URL=postgres://souqna:souqna@postgres:5432/souqna
REDIS_URL=redis://redis:6379

# --- Secrets: 32 random bytes, base64 ---
PHONE_HASH_KEY=__GENERATE__
OTP_HASH_KEY=__GENERATE__
IP_HASH_KEY=__GENERATE__
FIELD_ENCRYPTION_KEY_V1=__GENERATE__

# --- SMS ---
# mock prints codes to the API terminal and exposes them at /api/dev/otp (never in production)
SMS_PROVIDER=mock

# --- File storage (MinIO in development, Cloudflare R2 in production) ---
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=souqna-private
S3_ACCESS_KEY_ID=souqna
# Development-only MinIO password (matches .devcontainer/docker-compose.yml). Not a real secret.
S3_SECRET_ACCESS_KEY=souqna-dev-only
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKET=true
